# Copy to .env for local dev (never commit .env).
# On Netlify these go in Site configuration -> Environment variables.

# Password for the admin / submissions viewer. CHANGE THIS.
ADMIN_PASSWORD=change-me-before-you-deploy

# Secret URL path the admin page is served from, no leading slash.
# e.g. ADMIN_PATH=ledger-7 -> https://yoursite.netlify.app/ledger-7
ADMIN_PATH=ledger-7

# Optional: random string used to sign admin session tokens.
# If unset, one is derived from ADMIN_PASSWORD (changing the password logs you out).
ADMIN_SECRET=
